# RPC público de Polygon Amoy (testnet real, chainId 80002)
AMOY_RPC_URL=https://polygon-amoy-bor-rpc.publicnode.com
# Clave privada de la wallet relayer. Se genera con `npm run wallet`. NUNCA la subas a git.
RELAYER_PRIVATE_KEY=
# Se completa automáticamente tras `npm run deploy`
CONTRACT_ADDRESS=
# Propina por gas en gwei (Polygon exige ~25 mínimo)
GAS_PRIORITY_GWEI=30
